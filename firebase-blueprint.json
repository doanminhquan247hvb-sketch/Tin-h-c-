{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile information and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "TopicSnapshot": {
      "title": "Topic Snapshot",
      "description": "Saved study topic snapshots",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "subject": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "$ref:entities/UserProfile",
      "description": "User profiles collection"
    },
    "/topicSnapshots/{snapshotId}": {
      "schema": "$ref:entities/TopicSnapshot",
      "description": "Topic snapshots collection"
    }
  }
}
